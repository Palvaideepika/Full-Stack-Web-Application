<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Cognifyz Task Manager</title>

    <link rel="stylesheet" href="/style.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-dark bg-dark">

        <div class="container">

            <span class="navbar-brand mb-0 h1">
                Cognifyz Task Manager
            </span>

        </div>

    </nav>


    <!-- Hero Section -->

    <section class="hero-section text-center">

        <div class="container">

            <h1>Welcome to Cognifyz Task Manager</h1>

            <p>
                A simple full-stack web application built using
                Node.js, Express and EJS.
            </p>

        </div>

    </section>


    <!-- Information Section -->

    <section class="container my-5">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="info-card">

                    <h3>Easy to Use</h3>

                    <p>
                        Submit your information through a simple
                        and responsive form.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="info-card">

                    <h3>Validation</h3>

                    <p>
                        Client-side and server-side validation
                        help verify submitted information.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="info-card">

                    <h3>Responsive</h3>

                    <p>
                        The interface adapts to different screen
                        sizes using Bootstrap.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Form Section -->

    <section class="container form-section">

        <div class="form-card">

            <h2 class="text-center mb-4">
                User Information Form
            </h2>


            <form action="/submit" method="POST">

                <div class="mb-3">

                    <label for="name" class="form-label">
                        Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label for="email" class="form-label">
                        Email
                    </label>

                    <input
                        type="text"
                        id="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label for="password" class="form-label">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        placeholder="Enter your password"
                        required
                    >

                    <small id="passwordMessage" class="text-muted">

                        Password must contain at least 8 characters,
                        one uppercase letter, one lowercase letter,
                        and one number.

                    </small>

                </div>


                <div id="formMessage"
                     class="alert alert-info d-none">

                    Your information is ready to submit!

                </div>


                <div class="text-center">

                    <button
                        type="submit"
                        class="btn btn-primary submit-btn">

                        Submit

                    </button>

                </div>

            </form>


            <% if (message) { %>

                <div class="alert alert-success mt-4">

                    <%= message %>

                </div>

            <% } %>

        </div>

    </section>


    <!-- API Interaction Section -->

    <section class="container my-5">

        <div class="form-card">

            <h2 class="text-center mb-4">
                API Submissions
            </h2>


            <div class="text-center mb-3">

                <button
                    class="btn btn-primary"
                    onclick="loadSubmissions()">

                    Load Submissions

                </button>

            </div>


            <div id="apiMessage"
                 class="text-center mb-3">
            </div>


            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>

                        </tr>

                    </thead>


                    <tbody id="submissionTable">

                        <tr>

                            <td colspan="3"
                                class="text-center">

                                Click "Load Submissions"

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>


    <!-- User Registration Section -->

    <section class="container my-5">

        <div class="form-card">

            <h2 class="text-center mb-4">
                Create an Account
            </h2>


            <form id="registerForm">

                <div class="mb-3">

                    <label for="registerName"
                           class="form-label">

                        Name

                    </label>

                    <input
                        type="text"
                        id="registerName"
                        class="form-control"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label for="registerEmail"
                           class="form-label">

                        Email

                    </label>

                    <input
                        type="email"
                        id="registerEmail"
                        class="form-control"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label for="registerPassword"
                           class="form-label">

                        Password

                    </label>

                    <input
                        type="password"
                        id="registerPassword"
                        class="form-control"
                        placeholder="Create a password"
                        required
                    >

                </div>


                <div class="text-center">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Register

                    </button>

                </div>

            </form>


            <div id="registerMessage"
                 class="mt-3 text-center">
            </div>

        </div>

    </section>
<!-- USER LOGIN SECTION -->

<section class="container my-5">

    <div class="form-card">

        <h2 class="text-center mb-4">
            User Login
        </h2>

        <form id="loginForm">

            <div class="mb-3">

                <label for="loginEmail"
                       class="form-label">

                    Email

                </label>

                <input
                    type="email"
                    id="loginEmail"
                    class="form-control"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <div class="mb-3">

                <label for="loginPassword"
                       class="form-label">

                    Password

                </label>

                <input
                    type="password"
                    id="loginPassword"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <div class="text-center">

                <button
                    type="submit"
                    class="btn btn-success">

                    Login

                </button>

            </div>

        </form>


        <div id="loginMessage"
             class="mt-3 text-center">
        </div>

    </div>

</section>


    <!-- Footer -->

    <footer class="text-center">

        <p>© 2026 Cognifyz Task Manager</p>

    </footer>


    <!-- Client-side Validation -->

    <script>

        const form =
            document.querySelector("form");

        const formMessage =
            document.getElementById("formMessage");

        const passwordInput =
            document.getElementById("password");

        const passwordMessage =
            document.getElementById("passwordMessage");


        // Dynamic password strength checking

        passwordInput.addEventListener("input", function () {

            const password =
                passwordInput.value;

            const hasLength =
                password.length >= 8;

            const hasUppercase =
                /[A-Z]/.test(password);

            const hasLowercase =
                /[a-z]/.test(password);

            const hasNumber =
                /[0-9]/.test(password);


            if (
                hasLength &&
                hasUppercase &&
                hasLowercase &&
                hasNumber
            ) {

                passwordMessage.textContent =
                    "Strong password ✓";

            } else {

                passwordMessage.textContent =
                    "Password is weak. Use 8+ characters, uppercase, lowercase, and a number.";

            }

        });


        // Form validation

        form.addEventListener("submit", function (event) {

            const name =
                document.getElementById("name")
                    .value.trim();

            const email =
                document.getElementById("email")
                    .value.trim();

            const password =
                document.getElementById("password")
                    .value;


            // Check empty fields

            if (
                name === "" ||
                email === "" ||
                password === ""
            ) {

                event.preventDefault();

                alert("Please fill in all fields.");

                return;

            }


            // Check email

            if (!email.includes("@")) {

                event.preventDefault();

                alert("Please enter a valid email address.");

                return;

            }


            // Check password strength

            const strongPassword =
                password.length >= 8 &&
                /[A-Z]/.test(password) &&
                /[a-z]/.test(password) &&
                /[0-9]/.test(password);


            if (!strongPassword) {

                event.preventDefault();

                alert(
                    "Password must contain 8+ characters, uppercase, lowercase, and a number."
                );

                return;

            }


            // Dynamic success message

            formMessage.classList.remove("d-none");

            formMessage.textContent =
                "Your information is ready to submit!";

        });

    </script>


    <!-- API JavaScript -->

    <script>

        async function loadSubmissions() {

            const table =
                document.getElementById("submissionTable");

            const message =
                document.getElementById("apiMessage");


            try {

                const token = localStorage.getItem("token");

const response =
    await fetch("/api/submissions", {
        headers: {
            "Authorization": `Bearer ${token}`
        }
    });


                if (!response.ok) {

                    throw new Error(
                        "Failed to fetch submissions"
                    );

                }


                const submissions =
                    await response.json();


                table.innerHTML = "";


                if (submissions.length === 0) {

                    table.innerHTML = `

                        <tr>

                            <td colspan="3"
                                class="text-center">

                                No submissions found.

                            </td>

                        </tr>

                    `;

                    return;

                }


                submissions.forEach(submission => {

                    table.innerHTML += `

                        <tr>

                            <td>${submission.id}</td>

                            <td>${submission.name}</td>

                            <td>${submission.email}</td>

                        </tr>

                    `;

                });


                message.innerHTML =
                    '<span class="text-success">' +
                    'Data loaded successfully!' +
                    '</span>';


            } catch (error) {

                message.innerHTML =
                    '<span class="text-danger">' +
                    'Unable to load API data.' +
                    '</span>';

                console.error(error);

            }

        }

    </script>


    <!-- Registration JavaScript -->

    <script>

        const registerForm =
            document.getElementById("registerForm");

        const registerMessage =
            document.getElementById("registerMessage");


        registerForm.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();


                const name =
                    document.getElementById(
                        "registerName"
                    ).value.trim();


                const email =
                    document.getElementById(
                        "registerEmail"
                    ).value.trim();


                const password =
                    document.getElementById(
                        "registerPassword"
                    ).value;


                if (!name || !email || !password) {

                    registerMessage.innerHTML =
                        '<span class="text-danger">' +
                        'Please fill in all fields.' +
                        '</span>';

                    return;

                }


                try {

                    const response =
                        await fetch(
                            "/api/register",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({
                                    name: name,
                                    email: email,
                                    password: password
                                })
                            }
                        );


                    const data =
                        await response.json();


                    if (response.ok) {

                        registerMessage.innerHTML =
                            '<span class="text-success">' +
                            data.message +
                            '</span>';


                        registerForm.reset();


                    } else {

                        registerMessage.innerHTML =
                            '<span class="text-danger">' +
                            data.error +
                            '</span>';

                    }


                } catch (error) {

                    console.error(error);


                    registerMessage.innerHTML =
                        '<span class="text-danger">' +
                        'Unable to connect to the server.' +
                        '</span>';

                }

            }

        );

    </script>
<script>

    const loginForm =
        document.getElementById("loginForm");

    const loginMessage =
        document.getElementById("loginMessage");


    loginForm.addEventListener(
        "submit",
        async function (event) {

            event.preventDefault();


            const email =
                document.getElementById(
                    "loginEmail"
                ).value.trim();


            const password =
                document.getElementById(
                    "loginPassword"
                ).value;


            if (!email || !password) {

                loginMessage.innerHTML =
                    '<span class="text-danger">' +
                    'Please enter email and password.' +
                    '</span>';

                return;

            }


            try {

                const response =
                    await fetch(
                        "/api/login",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                email: email,
                                password: password
                            })
                        }
                    );


                const data =
                    await response.json();


                if (response.ok) {

                    loginMessage.innerHTML =
                        '<span class="text-success">' +
                        data.message +
                        '</span>';


                    // Store JWT token

                    localStorage.setItem(
                        "token",
                        data.token
                    );


                } else {

                    loginMessage.innerHTML =
                        '<span class="text-danger">' +
                        data.error +
                        '</span>';

                }


            } catch (error) {

                console.error(error);


                loginMessage.innerHTML =
                    '<span class="text-danger">' +
                    'Unable to connect to the server.' +
                    '</span>';

            }

        }

    );

</script>

</body>

</html>